{
    "name": "open-dxp/test-foundation",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "description": "Everything a bundle or a project needs to have tests against OpenDXP.",
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "dama/doctrine-test-bundle": "^8.6",
        "mtdowling/jmespath.php": "^2.8",
        "open-dxp/opendxp": "^1.3",
        "pestphp/pest": "^4.7 || ^5.0",
        "playwright-php/playwright": "^1.5",
        "playwright-php/playwright-symfony": "^0.11",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/process": "^7.4 || ^8.1",
        "symfony/runtime": "^7.4",
        "zenstruck/browser": "^1.12",
        "zenstruck/foundry": "^2.13"
    },
    "autoload": {
        "psr-4": {
            "OpenDxp\\TestFoundation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenDxp\\TestFoundation\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/opendxp-test"
    ],
    "extra": {
        "app-template": "app"
    },
    "minimum-stability": "stable"
}
